# ==============================================================
# CandidateVoice — Environment Variables Template
# ==============================================================
# INSTRUCTIONS:
#   1. Copy this file: cp .env.example .env.local
#   2. Fill in your actual values in .env.local
#   3. NEVER commit .env.local or any file with real keys
#   4. .env.local is already in .gitignore
# ==============================================================

# --------------------------------------------------------------
# SUPABASE — Required
# Get these from: https://app.supabase.com → Project → Settings → API
# --------------------------------------------------------------

# Your Supabase project URL (safe to expose in frontend)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon key — public, safe to ship in frontend bundle
# This key enforces RLS — users only see what policies allow
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase service role key — DANGEROUS. Server-side ONLY.
# Has full DB access, bypasses RLS. NEVER expose to client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# --------------------------------------------------------------
# APP CONFIG
# --------------------------------------------------------------

# Canonical URL of the app (used for redirects, OG tags, etc.)
# Local dev: http://localhost:3000
# Production: https://candidatevoice.io
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Admin moderation secret used by /api/admin/*
# Send in request header:
# Authorization: Bearer <ADMIN_SECRET>
ADMIN_SECRET=your-admin-secret-here

# HMAC secret for signed unlock cookie (server-only)
COOKIE_SECRET=replace_with_long_random_string

# --------------------------------------------------------------
# METADATA IMPORT — Optional (server-side scripts only, never the app)
# --------------------------------------------------------------

# GitHub API token for company metadata enrichment. Raises the rate limit from
# 60/hour (unauthenticated) to 5,000/hour. Only used by npm run companies:*.
# GITHUB_TOKEN=

# --------------------------------------------------------------
# EXTERNAL ACQUISITION — Optional, Phase-1 bootstrap only
# Used ONLY by scripts/reddit_ingest.py to read Reddit's official API. The
# adapter writes a JSONL file; it never touches the database. Register an app at
# https://www.reddit.com/prefs/apps (type: "script").
# --------------------------------------------------------------

# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=
# REDDIT_USER_AGENT=candidatevoice:v1.0 (by /u/yourusername)

# --------------------------------------------------------------
# PIXELRAG — Optional. See src/lib/external-intel/pixelrag.ts and
# DECISIONS.md D-027 for exactly what this does and does not do.
# --------------------------------------------------------------

# Hosted search API base URL. Defaults to https://api.pixelrag.ai, which needs
# no key today. Only override if pointing at a different deployment.
# PIXELRAG_API_URL=https://api.pixelrag.ai

# Optional bearer token, forwarded to the hosted API if it ever requires one.
# PIXELRAG_API_KEY=

# UNSET by default — the hosted API has no render endpoint. Point this at a
# self-hosted `pixelrag serve` instance's render endpoint to make
# pixelragRender() (external-intel/extract.ts's Case-1 pipeline) do real work
# instead of returning a documented "not configured" result.
# PIXELRAG_RENDER_URL=

# --------------------------------------------------------------
# OPTIONAL — Future phases
# --------------------------------------------------------------

# Analytics (Phase 6)
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=

# Email (Phase 4 — admin notifications)
# RESEND_API_KEY=
